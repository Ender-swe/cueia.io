COMPOSE_FILE=compose.yaml:compose.test-workspace.yaml:compose.local.yaml
COMPOSE_PROJECT_NAME=cueia-sample
POSTGRES_PASSWORD=cueia-local-dev
CPK_INTELLIGENCE_API_KEY=local-sample
CUEIA_PORT=8080
CUEIA_DASHBOARD_PORT=5173

# Use the publishable key and issuer URL from the same Clerk test instance.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTY=http://127.0.0.1:${CUEIA_DASHBOARD_PORT}

# Set these to the owner of the local sample disk directory (id -u and id -g).
CUEIA_TEST_DISK_DIR=$HOME/.local/share/cueia/sample-disks
CUEIA_TEST_UID=1000
CUEIA_TEST_GID=1000

# Optional accounts for unattended browser tests.
CLERK_SECRET_KEY=
CUEIA_TEST_USER_EMAIL=
CUEIA_TEST_BOB_EMAIL=
