{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "//#build:go": {
      "inputs": [
        "backend/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "GOCACHE",
        "GOMODCACHE",
        "GOPATH"
      ]
    },
    "//#type-check:go": {
      "inputs": [
        "backend/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "GOCACHE",
        "GOMODCACHE",
        "GOPATH"
      ]
    },
    "//#test:go": {
      "inputs": [
        "backend/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "GOCACHE",
        "GOMODCACHE",
        "GOPATH"
      ],
      "env": [
        "CUEIA_TEST_DATABASE_URL",
        "MIGRATIONS_DIR"
      ],
      "cache": false
    },
    "@cueia/api-types#type-check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/backend/api/openapi.yaml"
      ]
    }
  }
}
