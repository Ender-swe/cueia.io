{
  "name": "cueia",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "docker compose up -d --build --force-recreate",
    "stop": "docker compose down",
    "pretty": "prettier --ignore-path .prettierignore --write . && find apps/server -type d -name vendor -prune -o -type f -name '*.go' -exec gofmt -w {} +",
    "build": "turbo run build build:go",
    "type-check": "turbo run type-check type-check:go",
    "test": "turbo run test test:go",
    "build:go": "cd apps/server && go build ./cmd/...",
    "type-check:go": "cd apps/server && go vet ./...",
    "test:go": "cd apps/server && go test ./..."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  }
}
